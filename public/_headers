/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; connect-src 'none'; form-action https://buttondown.com; frame-ancestors 'none'; base-uri 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate

# Uwaga: świadomie BEZ długiego max-age na assets.
# Wcześniej stało tu 604800 (7 dni) — przeglądarki wracających użytkowników trzymały
# stary app.js mimo poprawnego deploya, przez co przestawał działać przycisk kontaktu.
# max-age=0 + must-revalidate = przeglądarka pyta o ETag i dostaje 304, jeśli nic się
# nie zmieniło. Przy plikach rzędu 10 kB koszt jest pomijalny, a strona nigdy nie jest
# nieaktualna. Dodatkowo linki w index.html mają ?v=N jako drugi bezpiecznik.

/favicon.svg
  Cache-Control: public, max-age=86400

# Gra Tilefall w przeglądarce (build z repo TilefallRoguelikePuzzle, npm run strona; patrz docs/DEPLOY.md,
# „Gra w przeglądarce”). Własna CSP, bo gra ma style w <style> w index.html i liczy piętra w Web Workerze.
# Bez indeksowania do premiery webowej. frame-ancestors 'self' pozwala osadzić grę w <iframe> na tej domenie.
/tilefall/play/*
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; worker-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'self'; base-uri 'self'
  X-Frame-Options: SAMEORIGIN
  X-Robots-Tag: noindex

# Pliki z hashem w nazwie (Vite) nigdy się nie zmieniają, więc mogą leżeć w cache bez końca.
/tilefall/play/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
